---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const postsByCategory = posts.reduce((acc, post) => {
	const category = post.data.category || 'Uncategorized';
	(acc[category] ??= []).push(post);
	return acc;
}, {} as Record<string, typeof posts>);
const categories = Object.keys(postsByCategory).sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
			.post-card { padding: 1.5rem; border-left: 4px solid var(--accent); border-radius: 8px; background: rgb(var(--gray-light)); transition: transform 0.2s, box-shadow 0.2s; }
			.post-card:hover { transform: translateY(-4px); box-shadow: var(--box-shadow); }
			.post-card h3 { margin-top: 0; margin-bottom: 0.5rem; }
			.post-card a { color: rgb(var(--black)); text-decoration: none; }
			.post-card a:hover { color: var(--accent); }
			.post-meta { margin-bottom: 1rem; color: rgb(var(--gray)); font-size: 0.875rem; }
			.post-description { margin-bottom: 1rem; color: rgb(var(--gray-dark)); line-height: 1.6; }
			.post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.tag { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 12px; background: var(--accent); color: white; font-size: 0.75rem; text-decoration: none; }
			.category-section { margin-bottom: 3rem; }
			.category-title { display: inline-block; margin-bottom: 2rem; padding-bottom: 0.5rem; border-bottom: 3px solid var(--accent); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Cafine Blog</h1>
			<p>프론트엔드 개발자의 기술 기록과 그래픽스 탐구를 담습니다.</p>

			{posts.length > 0 ? (
				<div>
					{categories.map((category) => (
						<section class="category-section">
							<h2 class="category-title">{category}</h2>
							<div class="post-grid">
								{postsByCategory[category].map((post) => (
									<article class="post-card">
										<h3><a href={`${base}/blog/${post.slug}/`}>{post.data.title}</a></h3>
										<div class="post-meta">{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
										<p class="post-description">{post.data.description}</p>
										{post.data.tags?.length > 0 && <div class="post-tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
									</article>
								))}
							</div>
						</section>
					))}
				</div>
			) : <p>아직 게시된 글이 없습니다.</p>}
		</main>
		<Footer />
	</body>
</html>
