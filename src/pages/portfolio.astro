---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { portfolioItems, portfolioProfile } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`Portfolio | ${SITE_TITLE}`}
			description="GPU, Vulkan, C++, OpenGL 관련 작업과 기술 글을 모아둔 포트폴리오 페이지"
		/>
		<style>
			.hero {
				display: grid;
				gap: 1.5rem;
				margin-bottom: 3rem;
			}
			.eyebrow {
				display: inline-flex;
				width: fit-content;
				padding: 0.35rem 0.75rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.9);
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				font-weight: 700;
			}
			.hero p {
				margin: 0;
				max-width: 60ch;
			}
			.highlight-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				padding: 0;
				margin: 0;
				list-style: none;
			}
			.highlight-list li {
				padding: 0.65rem 0.9rem;
				border: 1px solid rgba(var(--gray), 0.22);
				border-radius: 999px;
				background: white;
			}
			.section-title {
				margin-bottom: 1rem;
			}
			.project-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.project-card {
				display: grid;
				gap: 1rem;
				padding: 1.4rem;
				background: white;
				border: 1px solid rgba(var(--gray), 0.18);
				border-radius: 18px;
				box-shadow: 0 16px 30px rgba(var(--gray), 0.12);
			}
			.project-card-image {
				width: calc(100% + 2.8rem);
				height: 170px;
				margin: -1.4rem -1.4rem 0;
				object-fit: cover;
				object-position: top;
				border-radius: 18px 18px 0 0;
			}
			.project-meta {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.project-card h3 {
				margin-bottom: 0.25rem;
			}
			.project-card p {
				margin: 0;
			}
			.project-card a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.project-card a:hover h3 {
				color: var(--accent);
			}
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.3rem 0.7rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.9);
				font-size: 0.8rem;
				color: rgb(var(--gray-dark));
			}
			.note {
				margin-top: 3rem;
				padding: 1.4rem;
				border-left: 4px solid var(--accent);
				background: white;
				border-radius: 12px;
			}
			.note p {
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="eyebrow">Portfolio</span>
				<div>
					<h1>{portfolioProfile.title}</h1>
					<p>{portfolioProfile.intro}</p>
				</div>
				<ul class="highlight-list">
					{portfolioProfile.highlights.map((highlight) => <li>{highlight}</li>)}
				</ul>
			</section>

			<section>
				<h2 class="section-title">Selected Work</h2>
				<div class="project-grid">
					{portfolioItems.map((item) => (
						<article class="project-card">
							{item.image && <img class="project-card-image" src={`${base}${item.image}`} alt={`${item.title} 미리보기`} loading="lazy" />}
							<div class="project-meta">
								<span>{item.kind}</span>
								<span>{item.period}</span>
							</div>
							<div>
								<a href={`${base}${item.href}`}>
									<h3>{item.title}</h3>
								</a>
								<p>{item.summary}</p>
							</div>
							<div class="tag-list">
								{item.tags.map((tag) => <span class="tag">{tag}</span>)}
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="note">
				<p>
					이 페이지는 별도 프로젝트, 오픈소스 저장소, 발표 자료가 생길 때마다 같은 형식으로
					항목을 추가할 수 있도록 구성했습니다.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
