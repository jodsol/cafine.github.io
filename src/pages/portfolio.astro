---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { portfolioItems, portfolioProfile } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="실시간 서비스와 사용자 경험, 성능 개선을 중심으로 한 프론트엔드 프로젝트 포트폴리오" />
		<style>
			.hero { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
			.eyebrow { display: inline-flex; width: fit-content; padding: 0.35rem 0.75rem; border-radius: 999px; background: rgba(var(--gray-light), 0.9); color: rgb(var(--gray-dark)); font-size: 0.9rem; font-weight: 700; }
			.hero p { max-width: 60ch; margin: 0; }
			.highlight-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
			.highlight-list li { padding: 0.65rem 0.9rem; border: 1px solid rgba(var(--gray), 0.22); border-radius: 999px; background: white; }
			.section-title { margin-bottom: 1rem; }
			.project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
			.project-card { display: grid; gap: 1rem; overflow: hidden; padding: 1.4rem; border: 1px solid rgba(var(--gray), 0.18); border-radius: 18px; background: white; box-shadow: 0 16px 30px rgba(var(--gray), 0.12); }
			.project-card-image { width: calc(100% + 2.8rem); height: 170px; margin: -1.4rem -1.4rem 0; object-fit: cover; object-position: top; border-radius: 18px 18px 0 0; }
			.project-meta { display: flex; justify-content: space-between; gap: 1rem; color: rgb(var(--gray)); font-size: 0.9rem; }
			.project-card h3 { margin-bottom: 0.25rem; }
			.project-card p { margin: 0; }
			.project-card a { color: rgb(var(--black)); text-decoration: none; }
			.project-card a:hover h3 { color: var(--accent); }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.tag { padding: 0.3rem 0.7rem; border-radius: 999px; background: rgba(var(--gray-light), 0.9); color: rgb(var(--gray-dark)); font-size: 0.8rem; }
			.note { margin-top: 3rem; padding: 1.4rem; border-left: 4px solid var(--accent); border-radius: 12px; background: white; }
			.note p { margin: 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="eyebrow">Portfolio</span>
				<div>
					<h1>{portfolioProfile.title}</h1>
					<p>{portfolioProfile.intro}</p>
				</div>
				<ul class="highlight-list">{portfolioProfile.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
			</section>

			<section>
				<h2 class="section-title">Selected Work</h2>
				<div class="project-grid">
					{portfolioItems.map((item) => (
						<article class="project-card">
							{item.image && <Image class="project-card-image" src={item.image} alt={`${item.title} 미리보기`} width={600} height={170} fit="cover" loading="lazy" />}
							<div class="project-meta"><span>{item.kind}</span><span>{item.period}</span></div>
							<div>
								<a href={`${base}${item.href}`}><h3>{item.title}</h3></a>
								<p>{item.summary}</p>
							</div>
							<div class="tag-list">{item.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
						</article>
					))}
				</div>
			</section>

			<section class="note"><p>프로젝트별 상세 페이지에서 구현 배경, 기술 선택과 기여 내용을 확인할 수 있습니다.</p></section>
		</main>
		<Footer />
	</body>
</html>
